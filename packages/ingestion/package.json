{
  "name": "@avenire/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./file-contract": "./src/file-contract.ts",
    "./link": "./src/ingestion/link.ts",
    "./queue": "./src/queue.ts",
    "./runtime/redis-client": "./src/runtime/redis-client.ts",
    "./workspace-retrieval": "./src/workspace-retrieval.ts",
    "./types": "./src/ingestion/types.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --dir src",
    "test:coverage": "vitest run --coverage.enabled true --coverage.provider v8 --coverage.reporter text-summary --coverage.reporter json-summary --coverage.include 'src/**/*.ts' --coverage.exclude 'src/**/*.d.ts' --coverage.exclude 'src/**/*.test.*'",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.27",
    "@avenire/ai": "workspace:*",
    "@avenire/database": "workspace:*",
    "@avenire/observability": "workspace:*",
    "@mistralai/mistralai": "^1.14.1",
    "@tavily/core": "^0.7.6",
    "abso-ai": "^0.0.9",
    "ai": "^7.0.2",
    "bullmq": "^5.70.4",
    "defuddle": "^0.15.0",
    "drizzle-orm": "0.45.2",
    "linkedom": "^0.18.12",
    "officeparser": "7.2.3",
    "pdfjs-dist": "^5.4.624",
    "redis": "^5.11.0",
    "undici": "6.27.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@avenire/env-types": "workspace:*",
    "@avenire/typescript-config": "workspace:*",
    "@types/node": "25.4.0",
    "@vitest/coverage-v8": "4.1.7",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.7"
  }
}
