{
  "name": "@avenire/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./link": {
      "types": "./src/ingestion/link.ts",
      "default": "./dist/ingestion/link.js"
    },
    "./queue": {
      "types": "./src/queue.ts",
      "default": "./dist/queue.js"
    },
    "./workspace-retrieval": {
      "types": "./src/workspace-retrieval.ts",
      "default": "./dist/workspace-retrieval.js"
    },
    "./types": {
      "types": "./src/ingestion/types.ts",
      "default": "./dist/ingestion/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled true --coverage.provider v8 --coverage.reporter text-summary --coverage.reporter json-summary --coverage.include 'src/**/*.ts' --coverage.exclude 'src/**/*.d.ts' --coverage.exclude 'src/**/*.test.*'",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.26",
    "@avenire/ai": "workspace:*",
    "@avenire/database": "workspace:*",
    "@avenire/observability": "workspace:*",
    "@mistralai/mistralai": "^1.14.1",
    "defuddle": "^0.15.0",
    "linkedom": "^0.18.12",
    "@tavily/core": "^0.7.2",
    "abso-ai": "^0.0.9",
    "ai": "^6.0.141",
    "bullmq": "^5.70.4",
    "drizzle-orm": "0.45.1",
    "pdfjs-dist": "^5.4.624",
    "redis": "^5.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@avenire/env-types": "workspace:*",
    "@avenire/typescript-config": "workspace:*",
    "@types/node": "25.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "^4.1.2"
  }
}
