{
  "name": "@avenire/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./auth-schema": "./src/auth-schema.ts",
    "./client": "./src/client.ts",
    "./task-data": "./src/task-data.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled true --coverage.provider v8 --coverage.reporter text-summary --coverage.reporter json-summary --coverage.include 'src/**/*.ts' --coverage.exclude 'src/**/*.d.ts' --coverage.exclude 'src/**/*.test.*'",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@avenire/observability": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@avenire/env-types": "workspace:*",
    "@avenire/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.7",
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.9",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.7"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
