{
  "name": "avenire",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "prebuild": "bun packages/ai/skills/scripts/generator.ts",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:budget": "node scripts/report-test-budget.mjs",
    "test:coverage:repo": "node scripts/report-test-coverage.mjs",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "db:generate": "pnpm --filter @avenire/database db:generate",
    "db:migrate": "pnpm --filter @avenire/database db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "turbo": "latest",
    "typescript": "7.0.2",
    "ultracite": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@anaralabs/lector@3.8.0": "patches/@anaralabs__lector@3.8.0.patch"
    },
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "@hono/node-server": "1.19.12",
      "axios": "1.16.0",
      "basic-ftp": "5.3.1",
      "defu": "6.1.7",
      "drizzle-orm": "0.45.2",
      "effect": "3.20.0",
      "fast-uri": "3.1.2",
      "hono": "4.12.25",
      "kysely": "0.28.17",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch": "10.2.5",
      "next": "16.2.6",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "tar": "7.5.15",
      "undici": "6.27.0",
      "vite": "7.3.5",
      "ws": "8.21.0",
      "linkify-it": "5.0.1",
      "tmp": "0.2.7",
      "form-data": "4.0.6"
    }
  },
  "dependencies": {
    "vercel": "^51.7.0"
  }
}
