# Common
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# Platform-provided in hosted deployments.
VERCEL=
VERCEL_URL=
NEXT_RUNTIME=

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/avenire
REDIS_URL=redis://localhost:6379
PG_POOL_MAX=10
TRUSTED_STORAGE_HOSTS=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_EXTENSION_ORIGINS=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_NOTION_ID=
AUTH_NOTION_SECRET=
AVENIRE_EXTENSION_APP_ORIGINS=

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_DIMENSIONS=1024
COHERE_EMBEDDING_DIMENSIONS=1024
VOYAGE_EMBEDDING_DIMENSIONS=1024

# Resend
RESEND_API_KEY=
EMAIL_FROM="Avenire <support@avenire.space>"

# PostHog observability
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
OBSERVABILITY_ENABLED=false
OBSERVABILITY_AI_ENABLED=
OBSERVABILITY_AI_RECORD_INPUTS=false
OBSERVABILITY_AI_RECORD_OUTPUTS=false
OBSERVABILITY_SAMPLE_RATE=1
OBSERVABILITY_SERVICE=web

# Polar
POLAR_ACCESS_TOKEN=
POLAR_SERVER=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID_CORE_MONTHLY=
POLAR_PRODUCT_ID_CORE_YEARLY=
POLAR_PRODUCT_ID_SCHOLAR_MONTHLY=
POLAR_PRODUCT_ID_SCHOLAR_YEARLY=

# Billing
# Approximate chat credits using total model tokens. Default: 1000 tokens ~= 1 credit.
CHAT_TOKENS_PER_CREDIT=1000
# Fixed surcharge for each generated widget, charged in addition to model token usage.
WIDGET_GENERATION_CREDITS=20
# Turbo models such as apex-turbo/K2.6 Turbo charge this multiplier on model token usage.
TURBO_MODEL_CREDIT_MULTIPLIER=2
# Apex models such as apollo-apex/K2.7 Code charge this multiplier on model token usage.
APEX_MODEL_CREDIT_MULTIPLIER=1.5
# Dev-only chat route profiling. Adds profileAt, profileEpochMs, and profileProcessMs to api/chat logs.
CHAT_PROFILE_LOGS=false
CHAT_TITLE_MODEL=
CHAT_CONTEXT_MAX_CHARS=24000

# UploadThing
UPLOADTHING_TOKEN=
# Optional explicit webhook URL for UploadThing callbacks, useful behind proxies,
# tunnels, or protected preview deployments.
UPLOADTHING_CALLBACK_URL=
# Enable pre-upload hash+lookup dedupe in file explorer. Disabled by default to favor lower latency.
NEXT_PUBLIC_UPLOAD_PREUPLOAD_DEDUPE=false
# Max file size (bytes) to hash client-side for dedupe before upload. Set 0 to disable.
NEXT_PUBLIC_UPLOAD_DEDUPE_HASH_MAX_BYTES=12582912
UPLOAD_SESSION_TOKEN_SECRET=
UPLOAD_SESSION_MAX_PART_BYTES=16777216
# Optional temp dir for multipart part staging
UPLOAD_SESSION_PARTS_DIR=/tmp/avenire-upload-session-parts
VIDEO_OPTIMIZATION_MAX_UPLOAD_BUFFER_BYTES=524288000

# Google Picker
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=

# Ingestion worker
INGESTION_WORKER_PORT=3010
INGESTION_WORKER_CONCURRENCY=3
INGESTION_WORKER_MAX_ATTEMPTS=3
INGESTION_WORKER_RETRY_BASE_MS=1200
INGESTION_WORKER_RETRY_MAX_MS=30000
INGESTION_WORKER_RECOVERY_SWEEP_MS=15000

# Ingestion pipeline tuning
INGESTION_EMBED_BATCH_SIZE=64
INGESTION_EMBED_CONCURRENCY=2
INGESTION_DB_BATCH_SIZE=200
INGESTION_CHUNK_INSERT_BATCH_SIZE=200
INGESTION_MAX_INLINE_BYTES=10485760
INGESTION_MAX_MARKDOWN_CHARS=500000
INGESTION_MAX_URLS_PER_BATCH=32
INGESTION_STAGE_TIMING_LOG=true
INGESTION_REMOTE_FETCH_TIMEOUT_MS=15000
INGESTION_REMOTE_FETCH_MAX_ATTEMPTS=3
INGESTION_PDF_FAST_PATH_ENABLED=true
INGESTION_PDF_FAST_PATH_MIN_CHARS=900
INGESTION_PDF_FAST_PATH_MAX_PAGES=120
INGESTION_PDF_FETCH_TIMEOUT_MS=20000
IMAGE_ENRICHMENT_ENABLED=true
IMAGE_DESCRIPTION_MAX_CHARS=900
ENABLE_ASYNC_MEDIA_OPTIMIZATION=true
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_POLL_INTERVAL_MS=5000
MUX_POLL_MAX_ATTEMPTS=120
VIDEO_OPT_FETCH_TIMEOUT_MS=25000
VIDEO_KEYFRAME_INTERVAL_SECONDS=12
VIDEO_KEYFRAME_MAX_FRAMES=16
VIDEO_TRANSCRIPTION_SEGMENT_SECONDS=600
VIDEO_TRANSCRIPTION_MAX_SEGMENTS=36
MISTRAL_BATCH_POLL_MS=2500
MISTRAL_BATCH_TIMEOUT_MS=1800000
COHERE_RPM_LIMIT=12
COHERE_TPM_LIMIT=200000
COHERE_IMAGE_TOKEN_ESTIMATE=1200
COHERE_RETRY_MAX_ATTEMPTS=4
COHERE_RETRY_BASE_DELAY_MS=1200
COHERE_TEST_SAFE_MODE=true
COHERE_TEST_TPM_TARGET_RATIO=0.75
COHERE_TEST_TPM_HARD_CAP=100000
COHERE_TOKEN_ESTIMATE_SAFETY_FACTOR=1.4
COHERE_TEST_ADAPTIVE_MODE=true
COHERE_TEST_TPM_MIN_CAP=50000
COHERE_TEST_TPM_STEP_UP=10000
COHERE_TEST_TPM_STEP_DOWN_RATIO=0.5
COHERE_TEST_RPM_GUARD_ENABLED=true
RETRIEVAL_DEFAULT_LIMIT=8
RETRIEVAL_CANDIDATE_MULTIPLIER=5
RETRIEVAL_RERANK_CANDIDATE_LIMIT=12
RETRIEVAL_MIN_SCORE=0.18
RETRIEVAL_HYDE_ENABLED=true
RETRIEVAL_HYDE_MAX_OUTPUT_TOKENS=160
RETRIEVAL_HYDE_CANDIDATE_WEIGHT=0.92
RETRIEVAL_LEXICAL_CANDIDATE_WEIGHT=1.08
RETRIEVAL_TRIGRAM_CANDIDATE_WEIGHT=1.14
RETRIEVAL_SHADOW_SAMPLE_RATE=0.15
RETRIEVAL_WARMUP_MIN_CHUNKS=8
RETRIEVAL_WARMUP_SUMMARY_LIMIT=8
RETRIEVAL_WARMUP_QUERY_LIMIT=12
RETRIEVAL_SUMMARY_ATTACHMENT_LIMIT=3
RETRIEVAL_SUMMARY_ATTACHMENT_MAX_BYTES=8388608
RETRIEVAL_SUMMARY_FETCH_TIMEOUT_MS=20000
RETRIEVAL_SUMMARY_VALIDATION_MIN_CONFIDENCE=0.65
RETRIEVAL_QUERY_CACHE_TTL_SECONDS=45

# Workspace realtime stream
WORKSPACE_EVENTS_STREAM_MAXLEN=5000
WORKSPACE_EVENTS_STREAM_BLOCK_MS=15000
SSE_TOKEN_SECRET=

# Maintenance and internal administration
MAINTENANCE_CRON_TOKEN=
ADMIN_API_TOKEN=
